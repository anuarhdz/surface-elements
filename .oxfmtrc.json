{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "bracketSameLine": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "ignorePatterns": [
    "dist/**",
    ".vscode",
    ".claude",
    ".agents",
    ".github",
    "demo/**",
    "scripts",
    "pnpm-lock.yaml",
    "**/*.md"
  ]
}
