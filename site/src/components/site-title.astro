---
/**
 * Overrides Starlight's SiteTitle: a mono wordmark and the package version,
 * read from the root package.json so it follows each release.
 */
import pkg from "../../../package.json"

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title">
  <span class="mark" aria-hidden="true"></span>
  <span class="name" translate="no">{siteTitle}</span>
  <span class="version">v{pkg.version}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-inline-size: 0;
    font-family: var(--site-font-ui);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  /* A surface over a surface: the library in one glyph. */
  .mark {
    position: relative;
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
    border: 1.5px solid currentColor;
  }

  .mark::after {
    content: "";
    position: absolute;
    inset: 2px 2px 2px 50%;
    background: var(--sl-color-accent);
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .version {
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-2xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }

  .site-title:hover .name {
    color: var(--sl-color-accent);
  }
</style>
