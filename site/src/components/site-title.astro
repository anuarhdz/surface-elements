---
/**
 * Overrides Starlight's SiteTitle: a mono wordmark and the package version,
 * read from the root package.json so it follows each release.
 */
import pkg from "../../../package.json"

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title">
  <span class="mark" aria-hidden="true"></span>
  <span class="name" translate="no">{siteTitle}</span>
  <span class="version">v{pkg.version}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-inline-size: 0;
    font-family: var(--site-font-ui);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  /* A surface over a surface: the library in one glyph, sized by the
     capitals beside it. The fill is a grid layer, not a positioned box. */
  .mark {
    display: grid;
    flex: none;
    inline-size: 1.6cap;
    block-size: 1.6cap;
    padding: 2px;
    border: 1.5px solid currentColor;
  }

  .mark::after {
    content: "";
    justify-self: end;
    inline-size: 50%;
    background: var(--sl-color-accent);
  }

  .name {
    overflow: clip;
    text-overflow: ellipsis;
  }

  /* Trimmed to its capitals, so the badge's padding looks even. */
  .version {
    padding: 0.3125rem 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-2xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
    text-box: trim-both cap alphabetic;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-title:hover .name {
      color: var(--sl-color-accent);
    }
  }
</style>
