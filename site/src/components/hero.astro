---
/**
 * Overrides Starlight's Hero: the pitch and install command on one side, an
 * index of the web components on the other, with the gzip size of each copy
 * file (copy/<tag>.js, the element with every dependency inlined).
 */
import { gzipSync } from "node:zlib"
import { getCollection } from "astro:content"
import { LinkButton } from "@astrojs/starlight/components"

// Starlight's PAGE_TITLE_ID, which its package does not export.
const PAGE_TITLE_ID = "_top"

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}

const copies = import.meta.glob<string>("../../../copy/*.js", {
  query: "?raw",
  import: "default",
  eager: true,
})

const components = (
  await getCollection("docs", ({ id }) => id.startsWith("components/"))
)
  .map(({ id, data: page }) => {
    const tag = `surface-${id.split("/")[1]}`
    const code = copies[`../../../copy/${tag}.js`]

    const size = code
      ? `${(gzipSync(code).length / 1024).toFixed(1)} kB`
      : undefined

    return { href: `/${id}/`, title: page.title, tag, size }
  })
  .toSorted((a, b) => a.tag.localeCompare(b.tag))
---

<div class="hero not-content">
  <div class="intro">
    <p class="meta">
      <span>Web components</span>
      <span>Light DOM</span>
      <span>0 dependencies</span>
    </p>
    <h1 id={PAGE_TITLE_ID} set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <p class="install">
      <span class="prompt" aria-hidden="true">$</span>
      <code>pnpm add surface-elements</code>
    </p>
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ link, text, variant, icon }) => (
            <LinkButton href={link} variant={variant} icon={icon?.name}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>

  <nav class="index" aria-labelledby="hero-index-title">
    <p class="index-head" id="hero-index-title">
      <span>Elements</span>
      <span>gzip</span>
    </p>
    <ol>
      {
        components.map(({ href, title, tag, size }) => (
          <li>
            <a href={href}>
              <span class="tag">&lt;{tag}&gt;</span>
              <span class="title">{title}</span>
              {size && <span class="size">{size}</span>}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    margin-block-end: 3rem;
    padding-block: clamp(2rem, 1rem + 6vmin, 6rem) 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 0;
    font-family: var(--site-font-ui);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .meta span + span::before {
    content: "/";
    margin-inline: 0.75em;
    color: var(--sl-color-accent);
  }

  h1 {
    max-inline-size: 18ch;
    margin-block: 1.25rem 0;
    font-family: var(--site-font-ui);
    font-size: clamp(2.25rem, 1.25rem + 3.5vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .tagline {
    max-inline-size: 48ch;
    margin-block: 1.25rem 0;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-3);
    text-wrap: pretty;
  }

  .install {
    display: flex;
    gap: 0.75rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    margin-block: 2rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
    font-family: var(--site-font-ui);
    font-size: var(--sl-text-sm);
    overflow-x: auto;
  }

  .install code {
    color: var(--sl-color-white);
    user-select: all;
    white-space: nowrap;
  }

  .prompt {
    color: var(--sl-color-accent);
    user-select: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.25rem;
  }

  .index {
    align-self: end;
    border: 1px solid var(--sl-color-gray-5);
    font-family: var(--site-font-ui);
    font-size: var(--sl-text-xs);
  }

  .index-head {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0.5rem 1rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: element;
  }

  li + li {
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  .index a {
    counter-increment: element;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "num tag size"
      "num title size";
    column-gap: 1rem;
    align-items: baseline;
    padding: 0.875rem 1rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .index a::before {
    content: counter(element, decimal-leading-zero);
    grid-area: num;
    color: var(--sl-color-gray-3);
  }

  .tag {
    grid-area: tag;
    color: var(--sl-color-white);
    font-weight: 500;
  }

  .title {
    grid-area: title;
  }

  .size {
    grid-area: size;
    font-variant-numeric: tabular-nums;
  }

  .index a:hover {
    background: var(--sl-color-gray-7);
  }

  .index a:hover::before,
  .index a:hover .tag {
    color: var(--sl-color-accent);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }
</style>
