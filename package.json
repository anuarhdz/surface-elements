{
  "name": "surface-elements",
  "version": "0.0.1",
  "description": "Web Components for common interface surfaces.",
  "keywords": [
    "custom-elements",
    "dialog",
    "drawer",
    "header",
    "sticky",
    "web-components"
  ],
  "homepage": "https://github.com/anuarhdz/surface-elements#readme",
  "bugs": {
    "url": "https://github.com/anuarhdz/surface-elements/issues"
  },
  "license": "MIT",
  "author": "Anuar Reyes <anuar@hey.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuarhdz/surface-elements.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.js",
    "./dist/dialog-drawer/*.js",
    "./dist/header-sticky/*.js",
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./header-sticky": {
      "types": "./dist/header-sticky/header-sticky.d.ts",
      "import": "./dist/header-sticky/header-sticky.js"
    },
    "./dialog-drawer": {
      "types": "./dist/dialog-drawer/dialog-drawer.d.ts",
      "import": "./dist/dialog-drawer/dialog-drawer.js"
    },
    "./dialog-drawer.css": "./dist/dialog-drawer.css",
    "./dialog": {
      "types": "./dist/dialog/dialog.d.ts",
      "import": "./dist/dialog/dialog.js"
    },
    "./scroll-lock": {
      "types": "./dist/scroll-lock/scroll-lock.d.ts",
      "import": "./dist/scroll-lock/scroll-lock.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "pnpm --filter surface-elements-site dev",
    "docs:build": "pnpm --filter surface-elements-site build && pnpm playground:build",
    "playground:build": "vite build",
    "build": "tsdown && node scripts/emit-css.ts && pnpm run skills",
    "skills": "cem analyze && node scripts/emit-skills.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@oxlint/plugins": "1.80.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.10.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "1.56.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@12.14.0",
  "customElements": "./dist/custom-elements.json"
}
