{
  "name": "surface-elements",
  "version": "0.3.0",
  "description": "Web Components for common interface surfaces.",
  "keywords": [
    "accordion",
    "carousel",
    "custom-elements",
    "dialog",
    "drawer",
    "dropdown",
    "header",
    "modal",
    "slider",
    "sticky",
    "web-components"
  ],
  "homepage": "https://github.com/anuarhdz/surface-elements#readme",
  "bugs": {
    "url": "https://github.com/anuarhdz/surface-elements/issues"
  },
  "license": "MIT",
  "author": "Anuar Reyes <anuar@hey.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuarhdz/surface-elements.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.js",
    "./dist/accordion/*.js",
    "./dist/carousel/*.js",
    "./dist/drawer/*.js",
    "./dist/dropdown/*.js",
    "./dist/header/*.js",
    "./dist/modal/*.js",
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/accordion.d.ts",
      "import": "./dist/accordion/accordion.js"
    },
    "./accordion.css": "./dist/accordion.css",
    "./carousel": {
      "types": "./dist/carousel/carousel.d.ts",
      "import": "./dist/carousel/carousel.js"
    },
    "./carousel.css": "./dist/carousel.css",
    "./header": {
      "types": "./dist/header/header.d.ts",
      "import": "./dist/header/header.js"
    },
    "./header.css": "./dist/header.css",
    "./drawer": {
      "types": "./dist/drawer/drawer.d.ts",
      "import": "./dist/drawer/drawer.js"
    },
    "./drawer.css": "./dist/drawer.css",
    "./dropdown": {
      "types": "./dist/dropdown/dropdown.d.ts",
      "import": "./dist/dropdown/dropdown.js"
    },
    "./dropdown.css": "./dist/dropdown.css",
    "./modal": {
      "types": "./dist/modal/modal.d.ts",
      "import": "./dist/modal/modal.js"
    },
    "./modal.css": "./dist/modal.css",
    "./dialog": {
      "types": "./dist/dialog/dialog.d.ts",
      "import": "./dist/dialog/dialog.js"
    },
    "./scroll-lock": {
      "types": "./dist/scroll-lock/scroll-lock.d.ts",
      "import": "./dist/scroll-lock/scroll-lock.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "cem analyze && pnpm --filter surface-elements-site dev",
    "docs:build": "cem analyze && pnpm --filter surface-elements-site build && pnpm playground:build",
    "playground:build": "vite build",
    "build": "tsdown && node scripts/emit-css.ts && pnpm run skills && pnpm run copies",
    "skills": "cem analyze && node scripts/emit-skills.ts",
    "copies": "node scripts/emit-copies.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@oxlint/plugins": "1.80.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.10.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "1.56.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@12.14.0",
  "customElements": "./dist/custom-elements.json"
}
